{
  "meta": {
    "name": "Still Water",
    "rationale": "Cool fog and deep tide blue, a numbers-first ledger: mono digits, hairline rules, crisp small radii. Calm through order.",
    "themes": [
      "light",
      "dark"
    ]
  },
  "primitives": {
    "color": {
      "neutral": {
        "0": "#ffffff",
        "50": "#f5f7f8",
        "100": "#eceff1",
        "200": "#dde2e6",
        "300": "#c3cad0",
        "400": "#8f99a2",
        "500": "#6b7680",
        "600": "#525c65",
        "700": "#3d454d",
        "800": "#283037",
        "850": "#20272d",
        "900": "#181e23",
        "950": "#0f1418"
      },
      "tide": {
        "100": "#dcecf3",
        "200": "#b5d8e6",
        "300": "#7fbcd3",
        "600": "#1f6784",
        "700": "#18536b",
        "800": "#134356",
        "900": "#0b2a37"
      },
      "red": {
        "100": "#fde3e1",
        "300": "#f4a29b",
        "600": "#b42318",
        "800": "#7a1810",
        "900": "#4d0f0a"
      },
      "amber": {
        "100": "#fdf0d0",
        "300": "#f2c46b",
        "800": "#6b4a07",
        "900": "#3d2a04"
      },
      "green": {
        "100": "#dcf3e2",
        "300": "#86d19c",
        "800": "#1d5631",
        "900": "#10331c"
      },
      "blue": {
        "100": "#dde9fb",
        "300": "#93b8ef",
        "800": "#1b3f73",
        "900": "#0f2645"
      }
    }
  },
  "color": {
    "light": {
      "background": "{neutral.50}",
      "on-background": "{neutral.900}",
      "surface": "{neutral.0}",
      "on-surface": "{neutral.900}",
      "on-surface-variant": "{neutral.600}",
      "surface-container": "{neutral.100}",
      "surface-container-high": "{neutral.0}",
      "outline": "{neutral.500}",
      "outline-variant": "{neutral.200}",
      "primary": "{tide.600}",
      "on-primary": "{neutral.0}",
      "primary-container": "{tide.100}",
      "on-primary-container": "{tide.900}",
      "error": "{red.600}",
      "on-error": "{neutral.0}",
      "error-container": "{red.100}",
      "on-error-container": "{red.900}",
      "warning-container": "{amber.100}",
      "on-warning-container": "{amber.900}",
      "success-container": "{green.100}",
      "on-success-container": "{green.900}",
      "info-container": "{blue.100}",
      "on-info-container": "{blue.900}",
      "inverse-surface": "{neutral.800}",
      "on-inverse-surface": "{neutral.50}",
      "inverse-primary": "{tide.300}",
      "focus-ring": "{tide.700}",
      "scrim": "{neutral.950}"
    },
    "dark": {
      "background": "{neutral.950}",
      "on-background": "{neutral.100}",
      "surface": "{neutral.900}",
      "on-surface": "{neutral.100}",
      "on-surface-variant": "{neutral.300}",
      "surface-container": "{neutral.850}",
      "surface-container-high": "{neutral.800}",
      "outline": "{neutral.400}",
      "outline-variant": "{neutral.700}",
      "primary": "{tide.300}",
      "on-primary": "{tide.900}",
      "primary-container": "{tide.800}",
      "on-primary-container": "{tide.100}",
      "error": "{red.300}",
      "on-error": "{red.900}",
      "error-container": "{red.800}",
      "on-error-container": "{red.100}",
      "warning-container": "{amber.800}",
      "on-warning-container": "{amber.100}",
      "success-container": "{green.800}",
      "on-success-container": "{green.100}",
      "info-container": "{blue.800}",
      "on-info-container": "{blue.100}",
      "inverse-surface": "{neutral.100}",
      "on-inverse-surface": "{neutral.900}",
      "inverse-primary": "{tide.600}",
      "focus-ring": "{tide.200}",
      "scrim": "{neutral.950}"
    }
  },
  "contrast": [
    {
      "fg": "on-surface-variant",
      "bg": "surface-container-high",
      "use": "text"
    },
    {
      "fg": "on-primary",
      "bg": "primary",
      "use": "text"
    },
    {
      "fg": "on-primary-container",
      "bg": "primary-container",
      "use": "text"
    },
    {
      "fg": "primary",
      "bg": "surface-container-high",
      "use": "text"
    }
  ],
  "font": {
    "display": {
      "family": "IBM Plex Mono",
      "fallback": "ui-monospace, monospace",
      "google": "IBM Plex Mono:wght@400;500;600"
    },
    "body": {
      "family": "IBM Plex Sans",
      "fallback": "system-ui, sans-serif",
      "google": "IBM Plex Sans:wght@400;500;600"
    }
  },
  "type": {
    "display": {
      "font": "display",
      "size": 36,
      "line": 40,
      "weight": 500,
      "tracking": -1
    },
    "headline": {
      "font": "body",
      "size": 24,
      "line": 30,
      "weight": 600
    },
    "title": {
      "font": "body",
      "size": 17,
      "line": 24,
      "weight": 600
    },
    "title-sm": {
      "font": "body",
      "size": 15,
      "line": 22,
      "weight": 600
    },
    "body": {
      "font": "body",
      "size": 16,
      "line": 24,
      "weight": 400
    },
    "body-sm": {
      "font": "body",
      "size": 14,
      "line": 20,
      "weight": 400
    },
    "label": {
      "font": "body",
      "size": 13,
      "line": 18,
      "weight": 600,
      "tracking": 0.6
    },
    "caption": {
      "font": "display",
      "size": 12,
      "line": 16,
      "weight": 400,
      "tracking": 0
    }
  },
  "space": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48
  },
  "radius": {
    "sm": 4,
    "md": 6,
    "lg": 10,
    "xl": 16,
    "full": 9999
  },
  "size": {
    "control": 48,
    "touch": 48
  },
  "elevation": {
    "light": {
      "1": "0 1px 2px rgba(24,30,35,.08), 0 1px 3px rgba(24,30,35,.06)",
      "2": "0 4px 12px rgba(24,30,35,.10)",
      "3": "0 10px 30px rgba(24,30,35,.16)"
    },
    "dark": {
      "1": "0 1px 2px rgba(0,0,0,.5)",
      "2": "0 4px 12px rgba(0,0,0,.55)",
      "3": "0 10px 30px rgba(0,0,0,.6)"
    }
  },
  "icons": {
    "set": "material-symbols-outlined",
    "stroke": 1.5
  }
}